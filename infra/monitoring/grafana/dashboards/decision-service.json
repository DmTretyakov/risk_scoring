  {
   "type": "table",
   "title": "Latest drift run",
   "id": 22,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 10,
    "w": 10,
    "x": 0,
    "y": 33
   },
   "options": {
    "showHeader": true
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT feature, round(psi::numeric, 3) AS psi, status, companies, run_at\nFROM drift_runs\nWHERE run_at = (SELECT max(run_at) FROM drift_runs)\nORDER BY psi DESC NULLS LAST"
    }
   ],
   "description": "PSI: < 0.1 stable, 0.1-0.25 watch, > 0.25 act. One row per company per window."
  },
  {
   "type": "timeseries",
   "title": "PSI over time",
   "id": 23,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 10,
    "w": 14,
    "x": 10,
    "y": 33
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      },
