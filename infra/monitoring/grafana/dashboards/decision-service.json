    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT run_at AS time, feature AS metric, psi\nFROM drift_runs\nWHERE $__timeFilter(run_at) AND psi IS NOT NULL\nORDER BY 1"
    }
   ]
  },
